# Production database credentials (read-only). Get the real values from the operations
# team. Copy this file to .env and fill it in. Never commit the real values.
DB_USER=your_db_user
DB_PASSWORD=your_db_password # gitleaks:allow betterleaks:allow
DB_HOST=your-db-host.example.com
DB_PORT=25060
DB_NAME=treetracker

# SSH bastion
SSH_HOST=your-bastion-host
SSH_USER=your-ssh-user
