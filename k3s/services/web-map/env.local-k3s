# NEXT_PUBLIC_* for the :local web-map-client image (inlined at `next build`; copied over
# .env.production by web-map-client.Dockerfile). Single-origin gateway paths (ingress decision):
# the browser reaches everything through http://localhost:8088.
NEXT_PUBLIC_BASE=/map
NEXT_PUBLIC_API=/query
NEXT_PUBLIC_API_V2=/query/v2
NEXT_PUBLIC_TILE_SERVER_URL=/tiles/
NEXT_PUBLIC_TILE_SERVER_SUBDOMAINS=a
NEXT_PUBLIC_TILE_SERVER_WEBMAP_API=/webmap/
NEXT_PUBLIC_IMAGE_API=/images
# Leaderboard ships disabled = the production value (web-map decision 05).
NEXT_PUBLIC_COUNTRY_LEADER_BOARD_DISABLED=true
# No map-config-api locally (standalone-env research 08).
NEXT_PUBLIC_SERVER_CONFIG_DISABLED=true
# No external Google JS API call locally (web-map decision 06; guard patch in this dir).
NEXT_PUBLIC_GOOGLE_GEOMETRY_DISABLED=true
NEXT_PUBLIC_API_MOCKING=false
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_KEYCLOAK_URL=/keycloak/realms/treetracker/
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=raw-client
NEXT_PUBLIC_KEYCLOAK_REALM=treetracker
NEXT_PUBLIC_KEYCLOAK_REDIRECT_URI=/map/
NEXT_CACHE_REVALIDATION_OVERRIDE=43200
