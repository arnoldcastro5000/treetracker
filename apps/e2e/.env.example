# apps/e2e configuration. Copy to `.env` and fill in for a LOCAL run.
# CI injects these as environment values directly and ignores this file.

# Absolute path to the APK Appium installs and launches.
APK_PATH=/abs/path/to/treetracker-android/app/build/outputs/apk/debug/app-debug.apk

# Android applicationId of that APK. Must match the build variant:
#   debug -> org.greenstand.android.TreeTracker.debug
#   dev   -> org.greenstand.android.TreeTracker.dev
APP_PACKAGE=org.greenstand.android.TreeTracker.debug

# adb device id of your running emulator/device.
DEVICE_NAME=emulator-5554

# Admin panel used only by 03_capture_setup's verify step.
ADMIN_URL=https://dev-admin.treetracker.org
ADMIN_USER=test
ADMIN_PASSWORD=

# Cucumber tag filter (default: everything not tagged @skip).
# WDIO_TAGS=not @skip

# Evidence capture: set to 0 to disable screenshots + video (default on).
# CAPTURE_ARTIFACTS=1
